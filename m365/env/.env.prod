# This file includes environment variables that will be committed to git by default.
# No secrets. A confidential OAuth client's secret would go in env/.env.prod.user (gitignored).
#
# Store (Partner Center) build, made with `atk package --env prod` and never
# provisioned. TEAMS_APP_ID is the agent's stable store identity: keep it for
# every future submission. It is not registered in the Teams Developer Portal.
# The OAuth registration is the one created by the dev provision; it is bound
# to no app and no tenant (Any Teams app, Any Microsoft 365 organization, see
# m365agents.yml), so it serves both the sideloaded dev agent and the store agent.
# Read README.md ("Package for the store") before any `atk provision --env prod`
# or `atk publish --env prod`.

# Built-in environment variables
TEAMSFX_ENV=prod
APP_NAME_SUFFIX=

# Store app id (manifest "id"), generated on 2026-10-08, different from the dev app id.
TEAMS_APP_ID=b44aa36a-9971-4e9a-bd5c-251fd82e8917
# Written only by a provision (sideload); not used by the store package.
M365_TITLE_ID=
M365_APP_ID=

# Static OAuth client created in WorkOS AuthKit for Microsoft 365 Copilot
# (redirect URI https://teams.microsoft.com/api/platform/v1.0/oAuthRedirect).
MCP_DA_OAUTH_CLIENT_ID_EQOLUX=client_01M4D71QKRQJYE0MMF17KVHS35
# Comma-separated, as the oauth/register action expects.
MCP_DA_OAUTH_SCOPE_EQOLUX=openid,profile,email,offline_access
# Auth config id referenced by ai-plugin.json: the registration created by the
# dev provision on 2026-10-08 in the Eqolux tenant, reused as is (same value as env/.env.dev).
MCP_DA_AUTH_ID_EQOLUX=MDc2M2EzNGUtZDhhMS00YTcyLWEyMmEtY2Q2MDc4OGY0MTYzIyM1MDU3YWUzYy0wM2Q5LTQ4ODctOGU1Yy1kMjQ3MjJjNDlmMDU=
